10 REM HOW FAST ARE YOUR REFLEXES?
20 PRINT "{CLR}{WHT}REACTION TEST"
30 PRINT:PRINT "PRESS A KEY AS SOON AS THE"
40 PRINT "BORDER TURNS RED."
50 FOR I=1 TO 1000+RND(1)*2000:NEXT
60 GET K$:IF K$<>"" THEN PRINT "{LRED}TOO SOON! WAIT FOR RED.":GOTO 50
70 POKE 53280,2:T=TI
80 GET K$:IF K$="" THEN 80
90 POKE 53280,14
100 PRINT:PRINT "{YEL}YOUR TIME:";INT((TI-T)*1000/60);"MS"
110 PRINT "{WHT}PRESS A KEY TO TRY AGAIN."
120 GET K$:IF K$="" THEN 120
130 GOTO 20
